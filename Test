<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>โปรแกรมการกินอาหารสุกร ยูไนเต็ด</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Prompt', sans-serif; background-color: #fff5f7; margin: 0; padding: 0; }
        .gradient-header { background: linear-gradient(135deg, #9d174d 0%, #db2777 100%); }
        .product-card { border-bottom: 1px solid #fce7f3; min-height: 160px; }
        .product-card:last-child { border-bottom: none; }
        .img-box { width: 120px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
        .img-box img { max-width: 100%; max-height: 110px; object-fit: contain; filter: drop-shadow(0 5px 10px rgba(0,0,0,0.15)); }
        .huge-number { font-size: 1.6rem; line-height: 1; font-weight: 700; color: #1f2937; white-space: nowrap; }
        .huge-number-pink { font-size: 1.6rem; line-height: 1; font-weight: 700; color: #be185d; white-space: nowrap; }

        @media print {
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
            @page { size: A4 portrait; margin: 5mm; }
            body { background-color: white; }
            .no-print { display: none !important; }
            .a4-container { width: 100% !important; max-width: 100% !important; margin: 0 !important; box-shadow: none !important; border-radius: 0 !important; }
            .product-card { page-break-inside: avoid; }
        }

        .a4-container { width: 210mm; height: 297mm; margin: 10px auto; background: white; display: flex; flex-direction: column; }

        /* สไตล์แผงควบคุม Responsive */
        .control-panel-container { max-width: 600px; margin: 0 auto; width: 95%; background: #ffffff; padding: 20px; border-bottom: 4px solid #db2777; border-radius: 0 0 20px 20px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
        .input-row { display: flex; align-items: center; gap: 10px; background: #fff5f7; padding: 10px 15px; border-radius: 12px; border: 1px solid #fce7f3; margin-bottom: 8px; flex-wrap: wrap; }
        .product-label { min-width: 50px; font-weight: bold; color: #9d174d; }
        .input-group { display: flex; align-items: center; gap: 5px; flex: 1; min-width: 120px; }
        input[type="number"] { width: 100%; max-width: 80px; border: 1px solid #ddd; border-radius: 6px; padding: 5px; text-align: center; }
        .net-display { flex: 1; text-align: right; font-weight: bold; color: #be185d; min-width: 80px; }
    </style>
</head>
<body class="py-0 md:py-4">

    <div class="no-print control-panel-container">
        <h2 style="color: #db2777; font-weight: bold; margin-bottom: 15px; border-left: 5px solid #db2777; padding-left: 10px;">✍️ กรอกข้อมูลรายรายการ</h2>
        <div style="display: flex; flex-direction: column;">
            
            <script>
                function calc(id) {
                    const u = parseFloat(document.getElementById('in-u-' + id).value) || 0;
                    const p = parseFloat(document.getElementById('in-p-' + id).value) || 0;
                    const n = u * p;
                    
                    // อัปเดตช่องราคาสุทธิในแผงกรอก
                    document.getElementById('in-n-' + id).innerText = "฿" + n.toLocaleString();
                    
                    // ส่งค่าไปแสดงในโบร์ชัวร์
                    if(document.getElementById('u-' + id)) document.getElementById('u-' + id).innerText = u + " กระสอบ/ตัว";
                    if(document.getElementById('p-' + id)) document.getElementById('p-' + id).innerText = p.toLocaleString();
                    if(document.getElementById('n-' + id)) document.getElementById('n-' + id).innerText = n.toLocaleString();
                    
                    sumAll();
                }

                function sumAll() {
                    let totalNet = 0;
                    let totalBags = 0;
                    ['S80S', 'S20T', 'S21', 'S22', 'S23'].forEach(id => {
                        const u = parseFloat(document.getElementById('in-u-' + id).value) || 0;
                        const p = parseFloat(document.getElementById('in-p-' + id).value) || 0;
                        totalNet += (u * p);
                        totalBags += u;
                    });
                    if(document.getElementById('grand-total')) document.getElementById('grand-total').innerText = "฿" + totalNet.toLocaleString();
                    if(document.getElementById('total-bags')) document.getElementById('total-bags').innerText = totalBags + " กระสอบ";
                }
            </script>

            <div class="input-row"><div class="product-label">S80S</div><div class="input-group">ใช้ <input type="number" id="in-u-S80S" value="0.5" step="0.5" oninput="calc('S80S')"></div><div class="input-group">ถุงละ <input type="number" id="in-p-S80S" value="736" oninput="calc('S80S')"></div><div class="net-display" id="in-n-S80S">฿368</div></div>
            <div class="input-row"><div class="product-label">S20T</div><div class="input-group">ใช้ <input type="number" id="in-u-S20T" value="0.5" step="0.5" oninput="calc('S20T')"></div><div class="input-group">ถุงละ <input type="number" id="in-p-S20T" value="620" oninput="calc('S20T')"></div><div class="net-display" id="in-n-S20T">฿310</div></div>
            <div class="input-row"><div class="product-label">S21</div><div class="input-group">ใช้ <input type="number" id="in-u-S21" value="2" step="0.5" oninput="calc('S21')"></div><div class="input-group">ถุงละ <input type="number" id="in-p-S21" value="482" oninput="calc('S21')"></div><div class="net-display" id="in-n-S21">฿964</div></div>
            <div class="input-row"><div class="product-label">S22</div><div class="input-group">ใช้ <input type="number" id="in-u-S22" value="3" step="0.5" oninput="calc('S22')"></div><div class="input-group">ถุงละ <input type="number" id="in-p-S22" value="452" oninput="calc('S22')"></div><div class="net-display" id="in-n-S22">฿1,356</div></div>
            <div class="input-row"><div class="product-label">S23</div><div class="input-group">ใช้ <input type="number" id="in-u-S23" value="1" step="0.5" oninput="calc('S23')"></div><div class="input-group">ถุงละ <input type="number" id="in-p-S23" value="430" oninput="calc('S23')"></div><div class="net-display" id="in-n-S23">฿430</div></div>
        </div>
        <button onclick="window.print()" style="width: 100%; background: #be185d; color: white; padding: 12px; border: none; border-radius: 12px; font-weight: bold; margin-top: 15px; cursor: pointer;">🖨️ สั่งพิมพ์โบร์ชัวร์ (PDF)</button>
    </div>

    <div class="a4-container shadow-2xl rounded-[1.5rem] overflow-hidden">
        <div class="gradient-header p-2 text-white text-center">
            <h1 class="text-2xl md:text-3xl font-bold mb-0.5">โปรแกรมการกินอาหารสุกร ยูไนเต็ด</h1>
            <p class="text-pink-100 text-base font-light">(สูตร 1) - คุณภาพที่เหนือกว่าเพื่อการเติบโตที่ต่อเนื่อง</p>
        </div>

        <div class="px-6 py-1 flex-grow flex flex-col justify-start gap-y-1">
            <div class="product-card flex flex-row gap-6 py-2.5 items-center">
                <div class="img-box"><img src="S80S.png" alt="S80S"></div>
                <div class="flex-grow">
                    <div class="flex justify-between items-baseline mb-0.5">
                        <div class="flex items-baseline gap-3"><h2 class="text-2xl font-bold text-pink-800 leading-tight">ยูไนเต็ด S80S</h2><span class="text-[14px] text-gray-900 font-medium italic">แรกเกิด-15 กก.</span></div>
                        <span class="bg-pink-700 text-white text-[16px] px-2 py-0.5 rounded-full font-bold uppercase relative -top-1">หมูเลียราง</span>
                    </div>
                    <p class="text-gray-900 text-[14px] mt-1 mb-2 leading-snug min-h-[32px]">ทดแทนน้ำนมแม่ ช่วยการเจริญเติบโตเสริมโครงสร้าง เสริมยาปฏิชีวนะ</p>
                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100"><p class="text-[14px] text-gray-600 font-bold uppercase">อัตราการใช้</p><p class="huge-number" id="u-S80S">0.5 กระสอบ/ตัว</p></div>
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100"><p class="text-[14px] text-gray-600 font-bold uppercase">ราคา/ถุง</p><p class="huge-number" id="p-S80S">736</p></div>
                        <div class="bg-pink-50 p-2 rounded-lg border border-pink-100 text-pink-700"><p class="text-[14px] text-pink-600 font-bold uppercase">ราคาสุทธิ</p><p class="huge-number-pink" id="n-S80S">368</p></div>
                    </div>
                </div>
            </div>

            <div class="product-card flex flex-row gap-6 py-2.5 items-center">
                <div class="img-box"><img src="S20T.png" alt="S20T"></div>
                <div class="flex-grow">
                    <div class="flex justify-between items-baseline mb-0.5">
                        <div class="flex items-baseline gap-3"><h2 class="text-2xl font-bold text-pink-800 leading-tight">ยูไนเต็ด S20T</h2><span class="text-[14px] text-gray-900 font-medium italic">หย่านม-30กก.</span></div>
                        <span class="bg-pink-700 text-white text-[16px] px-2 py-0.5 rounded-full font-bold uppercase relative -top-1">หมูอนุบาล</span>
                    </div>
                    <p class="text-gray-900 text-[14px] mt-1 mb-2 leading-snug min-h-[32px]">ปรับสภาพลูกสุกรหลังหย่านม เสริมสร้างพัฒนาการ สุขภาพแข็งแรง</p>
                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100"><p class="text-[14px] text-gray-600 font-bold uppercase">อัตราการใช้</p><p class="huge-number" id="u-S20T">0.5 กระสอบ/ตัว</p></div>
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100"><p class="text-[14px] text-gray-600 font-bold uppercase">ราคา/ถุง</p><p class="huge-number" id="p-S20T">620</p></div>
                        <div class="bg-pink-50 p-2 rounded-lg border border-pink-100 text-pink-700"><p class="text-[14px] text-pink-600 font-bold uppercase">ราคาสุทธิ</p><p class="huge-number-pink" id="n-S20T">310</p></div>
                    </div>
                </div>
            </div>

            <div class="product-card flex flex-row gap-6 py-2.5 items-center">
                <div class="img-box"><img src="S21.png" alt="S21"></div>
                <div class="flex-grow">
                    <div class="flex justify-between items-baseline mb-0.5">
                        <div class="flex items-baseline gap-3"><h2 class="text-2xl font-bold text-pink-800 leading-tight">ยูไนเต็ด S21</h2><span class="text-[14px] text-gray-900 font-medium italic">15-30กก.</span></div>
                        <span class="bg-pink-700 text-white text-[16px] px-2 py-0.5 rounded-full font-bold uppercase relative -top-1">หมูเล็ก</span>
                    </div>
                    <p class="text-gray-900 text-[14px] mt-1 mb-2 leading-snug min-h-[32px]">ช่วยเร่งการสร้างกล้ามเนื้อ เพื่อการเจริญเติบโตต่อเนื่อง</p>
                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100"><p class="text-[14px] text-gray-600 font-bold uppercase">อัตราการใช้</p><p class="huge-number" id="u-S21">2 กระสอบ/ตัว</p></div>
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100"><p class="text-[14px] text-gray-600 font-bold uppercase">ราคา/ถุง</p><p class="huge-number" id="p-S21">482</p></div>
                        <div class="bg-pink-50 p-2 rounded-lg border border-pink-100 text-pink-700"><p class="text-[14px] text-pink-600 font-bold uppercase">ราคาสุทธิ</p><p class="huge-number-pink" id="n-S21">964</p></div>
                    </div>
                </div>
            </div>

            <div class="product-card flex flex-row gap-6 py-2.5 items-center">
                <div class="img-box"><img src="S22.png" alt="S22"></div>
                <div class="flex-grow">
                    <div class="flex justify-between items-baseline mb-0.5">
                        <div class="flex items-baseline gap-3"><h2 class="text-2xl font-bold text-pink-800 leading-tight">ยูไนเต็ด S22</h2><span class="text-[14px] text-gray-900 font-medium italic">30-60กก.</span></div>
                        <span class="bg-pink-700 text-white text-[16px] px-2 py-0.5 rounded-full font-bold uppercase relative -top-1">หมูรุ่น</span>
                    </div>
                    <p class="text-gray-900 text-[14px] mt-1 mb-2 leading-snug min-h-[32px]">ช่วยพัฒนาและสร้างกล้ามเนื้อ สารอาหารเหมาะสม</p>
                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100"><p class="text-[14px] text-gray-600 font-bold uppercase">อัตราการใช้</p><p class="huge-number" id="u-S22">3 กระสอบ/ตัว</p></div>
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100"><p class="text-[14px] text-gray-600 font-bold uppercase">ราคา/ถุง</p><p class="huge-number" id="p-S22">452</p></div>
                        <div class="bg-pink-50 p-2 rounded-lg border border-pink-100 text-pink-700"><p class="text-[14px] text-pink-600 font-bold uppercase">ราคาสุทธิ</p><p class="huge-number-pink" id="n-S22">1,356</p></div>
                    </div>
                </div>
            </div>

            <div class="product-card flex flex-row gap-6 py-2.5 items-center">
                <div class="img-box"><img src="S23.png" alt="S23"></div>
                <div class="flex-grow">
                    <div class="flex justify-between items-baseline mb-0.5">
                        <div class="flex items-baseline gap-2"><h2 class="text-2xl font-bold text-pink-800 leading-tight">ยูไนเต็ด S23</h2><span class="text-[14px] text-gray-900 font-medium italic">60กก.-ขาย</span></div>
                        <span class="bg-pink-700 text-white text-[16px] px-2 py-0.5 rounded-full font-bold uppercase relative -top-1">หมูขุน</span>
                    </div>
                    <p class="text-gray-900 text-[14px] mt-1 mb-2 leading-snug min-h-[32px]">ช่วยการเจริญเติบโตในระยะท้าย เสริมสร้างกล้ามเนื้อ</p>
                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100"><p class="text-[14px] text-gray-600 font-bold uppercase">อัตราการใช้</p><p class="huge-number" id="u-S23">1 กระสอบ/ตัว</p></div>
                        <div class="bg-gray-50 p-2 rounded-lg border border-gray-100"><p class="text-[14px] text-gray-600 font-bold uppercase">ราคา/ถุง</p><p class="huge-number" id="p-S23">430</p></div>
                        <div class="bg-pink-50 p-2 rounded-lg border border-pink-100 text-pink-700"><p class="text-[14px] text-pink-600 font-bold uppercase">ราคาสุทธิ</p><p class="huge-number-pink" id="n-S23">430</p></div>
                    </div>
                </div>
            </div>

            <div class="flex flex-row justify-between items-stretch mt-1">
              <div class="bg-white border-2 border-yellow-400 rounded-2xl p-2 px-6 shadow-lg min-w-[280px] flex flex-col justify-upper">
                    <p class="text-[16px] uppercase font-bold text-gray-600 opacity-70">ติดต่อ</p>
                    <h3 class="text-xl font-black text-gray-800"></h3>
                </div>
                <div class="bg-yellow-400 rounded-2xl p-2 px-6 flex flex-row gap-x-8 items-center text-gray-900 shadow-lg w-fit">
                    <div><p class="text-[16px] uppercase font-bold opacity-70">ปริมาณอาหารรวม</p><h3 class="text-3xl font-black" id="total-bags">7 กระสอบ</h3></div>
                    <div class="text-right"><p class="text-[16px] uppercase font-bold opacity-70">ต้นทุนรวมสุทธิ / ตัว</p><h3 class="text-4xl font-black text-green-700" id="grand-total">฿3,428</h3></div>
                </div>
            </div>

            <div class="text-center text-gray-800 py-5"><p class="text-[16px] font-medium text-gray-900 italic">อัปเดตราคาล่าสุด: 20 เม.ย. 69 | *อัตราการใช้อาจเปลี่ยนตามปัจจัยการเลี้ยง</p></div>
        </div>
    </div>
    <script>window.onload = sumAll;</script>
</body>
</html>
